# ==========================================
# SRYN FinServ Environment Template
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sryn_finserv_db
DB_USER=postgres
DB_PASSWORD=local_dev_password_only
DB_SSL=false
# Optional full connection string:
# DATABASE_URL=postgresql://postgres:local_dev_password_only@localhost:5432/sryn_finserv_db

# Authentication Configuration
# Strictly DEVELOPMENT ONLY. Automatically disabled if NODE_ENV=production
ENABLE_LOCAL_AUTH_FALLBACK=true
JWT_SECRET=development_jwt_secret_key_change_in_production_min32chars
JWT_EXPIRES_IN=1d

# AWS Configuration (Mumbai ap-south-1)
AWS_REGION=ap-south-1
AWS_COGNITO_USER_POOL_ID=ap-south-1_examplePoolId
AWS_COGNITO_CLIENT_ID=exampleClientId
AWS_S3_DOCUMENT_BUCKET=sryn-finserv-documents-dev-ap-south-1
AWS_SECRETS_MANAGER_SECRET_ID=sryn-finserv/dev/db-credentials

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002
